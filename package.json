{
  "name": "trading-analyzer",
  "version": "0.1.0",
  "description": "TradingView chart analysis menubar app",
  "main": "dist/main/main/index.js",
  "private": true,
  "scripts": {
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "dev": "tsc -p tsconfig.main.json && concurrently -k -n \"MAIN,VITE,APP\" -c \"cyan,yellow,green\" \"tsc -w -p tsconfig.main.json\" \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:all": "tsc -p tsconfig.main.json && concurrently --kill-others-on-fail -n \"MAIN,VITE,APP,JOURNAL\" -c \"cyan,yellow,green,magenta\" \"tsc -w -p tsconfig.main.json\" \"vite\" \"wait-on http://localhost:5173 && electron .\" \"node scripts/start-journal.js\"",
    "build": "tsc -p tsconfig.main.json && vite build && npm run build:journal",
    "build:journal": "vite build --config vite.journal.config.ts",
    "dev:journal": "vite --config vite.journal.config.ts",
    "journal": "node scripts/start-journal.js",
    "package": "npm run build && electron-builder",
    "test": "node --test 'tests/shared/**/*.test.js'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "better-sqlite3": "^9.0.0",
    "chrome-remote-interface": "^0.34.0",
    "dotenv": "^17.4.2",
    "express": "^4.18.0",
    "googleapis": "^172.0.0",
    "menubar": "^9.3.0",
    "recharts": "^2.10.0",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.0",
    "electron": "30.5.1",
    "electron-builder": "^24.13.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "wait-on": "^7.2.0"
  }
}
