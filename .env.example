# Active LLM provider is set by `llm.provider` in config/config.json.
# Only the key for the active provider is required.

# Anthropic — the default provider. Paid credits required.
# Get one at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini — used when llm.provider is "gemini" (the parked `gemini` block).
# Free tier, but capped at 20 requests/day/model, which a per-bar monitor
# exhausts in minutes. Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth2 credentials for Drive export
# Create at: https://console.cloud.google.com → OAuth 2.0 Client IDs → Desktop app
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here
